{
  "name": "@app/db",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../api/.env -- prisma migrate dev -n init",
    "migrate:deploy": "dotenv -e ../api/.env -- prisma migrate deploy",
    "studio": "prisma studio",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "prisma": "^6.13.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "typescript": "^5.5.4"
  }
}
