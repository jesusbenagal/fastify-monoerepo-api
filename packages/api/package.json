{
  "name": "@app/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "dev:fast": "tsx --watch --clear-screen=false src/index.ts",
    "dev:nodemon": "nodemon",
    "dev:full": "concurrently \"pnpm lint:watch\" \"pnpm dev\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "lint:watch": "eslint . --ext .ts --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "cross-env NODE_ENV=test jest --config jest.config.cjs",
    "test:watch": "cross-env NODE_ENV=test jest --config jest.config.cjs --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --config jest.config.cjs --coverage",
    "test:setup": "cross-env NODE_ENV=test tsx scripts/setup-test-db.ts"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.4.1",
  "dependencies": {
    "@app/db": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.1.0",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "dotenv": "^17.2.1",
    "fastify": "^5.4.0",
    "socket.io": "^4.8.1",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.2.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.0.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^30.0.5",
    "nodemon": "^3.1.0",
    "pino-pretty": "^12.0.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
