{
  "name": "fastify-api",
  "private": false,
  "scripts": {
    "start": "pnpm --filter @app/api start",
    "dev": "pnpm --filter @app/api dev",
    "dev:fast": "pnpm --filter @app/api dev:fast",
    "dev:nodemon": "pnpm --filter @app/api dev:nodemon",
    "build": "pnpm -r build",
    "test": "pnpm --filter @app/api test",
    "db:studio": "pnpm --filter @app/db run studio",
    "db:migrate": "pnpm --filter @app/db run migrate",
    "db:deploy": "pnpm --filter @app/db run migrate:deploy",
    "postinstall": "pnpm --filter @app/db run generate"
  }
}
